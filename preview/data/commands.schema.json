{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FERRIN Drift Ops commands",
  "type": "object",
  "required": ["version", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "surfaces", "triggers", "lines", "rows", "reducedMotionRows", "mood", "rarity"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "category": { "type": "string" },
          "surfaces": { "type": "array", "items": { "enum": ["skill", "preview"] }, "minItems": 1 },
          "triggers": {
            "type": "object",
            "properties": {
              "verbs": { "type": "array", "items": { "type": "string" } },
              "keys": { "type": ["array", "null"], "items": { "type": "string" } },
              "clicks": { "type": ["object", "null"] },
              "date": { "type": ["object", "null"] },
              "time": { "type": ["object", "null"] }
            }
          },
          "lines": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["text", "weight"],
              "properties": {
                "text": { "type": "string", "pattern": "^\\S+(\\s+\\S+){0,11}$" },
                "weight": { "type": "integer", "minimum": 1 },
                "when": { "type": "string" }
              }
            }
          },
          "rows": { "type": "array", "items": { "$ref": "#/$defs/row" }, "minItems": 1 },
          "reducedMotionRows": { "type": "array", "items": { "$ref": "#/$defs/row" }, "minItems": 1 },
          "mood": {
            "type": "object",
            "properties": {
              "power": { "type": "integer", "minimum": -10, "maximum": 10 },
              "sync": { "type": "integer", "minimum": -10, "maximum": 10 },
              "morale": { "type": "integer", "minimum": -10, "maximum": 10 }
            }
          },
          "rarity": { "enum": ["standard", "rumored", "hidden", "rare", "dated"] },
          "unlocks": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "row": { "type": "string", "pattern": "^(idle|running-right|running-left|waving|jumping|failed|waiting|running|review|look:([0-9]|1[0-5]))$" }
  }
}
